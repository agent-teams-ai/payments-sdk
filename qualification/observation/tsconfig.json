{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": false,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["*.ts"],
  "references": [
    { "path": "../../packages/payments-core" },
    { "path": "../../packages/payments-paddle" },
    { "path": "../../packages/payments-postgres" },
    { "path": "../../packages/payments-get-modular" }
  ]
}
