      "input": ["purchaseReadInput", "projectionConfigurationInput", "projectionRendererInput"],
      "implement": ["purchaseProjectionModule", "purchaseProjectionDisplayModule"],
      "group": ["purchaseObservationGroup"]
    }
  },
  "exceptions": [{
    "id": "technical-adapter-layout",
    "rule": "CMS feature layout and separate declaration/entry files",
    "paths": [
