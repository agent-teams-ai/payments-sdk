      "packages/payments-get-modular/src/observation/projection.ts"
    ],
    "owner": "payments-sdk/composition",
    "rationale": "This delivery package is a public technical composition adapter. It owns no payment domain or persistence policy; descriptors, inline entries and the resource-aware projection keep their current small SDK layout.",
