{
  "extends": [
    "./node_modules/stack-toolchain/presets/oxlint/type-aware.json",
    "./node_modules/stack-toolchain/presets/oxlint/maintainability.json"
  ],
  "rules": {
    "no-debugger": "error",
    "no-unused-vars": "error",
    "typescript/no-explicit-any": "error",
    "typescript/method-signature-style": ["error", "property"]
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/.artifacts/**"],
  "options": {
    "respectEslintDisableDirectives": false,
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      "files": ["packages/payments-get-modular/src/features/**/*.ts"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 300,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "max-lines-per-function": [
          "error",
          {
            "max": 60,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "max-params": ["error", 4]
      }
    },
    {
      "files": ["packages/payments-get-modular/src/features/**/composition/*.module.ts"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 80,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    }
  ]
}
