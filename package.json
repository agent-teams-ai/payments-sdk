{
  "name": "@agent-teams/payments-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.21.0 <25 || >=26.11.1 <27",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.checks.json",
    "lint": "oxlint --config .oxlintrc.json packages tests tools",
    "foundation:check": "agent-teams-foundation check",
    "foundation:assert-dev-only": "agent-teams-foundation assert-dev-only",
    "foundation:assert-registry": "agent-teams-foundation assert-registry",
    "test:boundaries": "node --test tools/test/boundaries.test.ts",
    "test:core": "node tools/run-tests.ts core",
    "test:paddle": "node tools/run-tests.ts paddle",
    "test:modular": "node tools/run-tests.ts modular",
    "test:postgres": "node tools/run-tests.ts postgres",
    "test:e2e": "node tools/run-tests.ts e2e",
    "test:packed": "node tools/packed-consumers.ts",
    "release:dry-run": "node tools/release-dry-run.ts",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm foundation:check",
    "check": "pnpm check:fast && pnpm foundation:assert-dev-only && pnpm foundation:assert-registry && pnpm test:boundaries && pnpm test:core && pnpm test:paddle && pnpm test:modular && pnpm test:postgres && pnpm test:e2e && pnpm test:packed && pnpm release:dry-run"
  },
  "devDependencies": {
    "@agent-teams/engineering-foundation": "1.10.0",
    "@agent-teams/payments-core": "workspace:*",
    "@agent-teams/payments-paddle": "workspace:*",
    "@agent-teams/payments-postgres": "workspace:*",
    "@agent-teams/payments-get-modular": "workspace:*",
    "@get-modular/core": "catalog:",
    "@get-modular/assembly": "catalog:",
    "@get-modular/resources": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "pg": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "undici": "catalog:",
    "yaml": "catalog:"
  }
}
