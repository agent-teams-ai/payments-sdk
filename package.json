{
  "name": "@agent-teams/payments-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1 <27",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "build": "node tools/build.ts",
    "typecheck": "pnpm build && pnpm typecheck:checks",
    "toolchain:check": "node tools/toolchain.ts",
    "lint": "pnpm lint:production && pnpm lint:development",
    "foundation:check": "agent-teams-foundation check",
    "foundation:status": "agent-teams-foundation status",
    "foundation:attach": "agent-teams-foundation attach",
    "foundation:detach": "agent-teams-foundation detach",
    "foundation:assert-dev-only": "agent-teams-foundation assert-dev-only",
    "foundation:assert-registry": "agent-teams-foundation assert-registry",
    "test:runtime-security": "node tools/runtime-security-probe.ts",
    "test:boundaries": "node --test tools/test/*.test.ts",
    "test:core": "node tools/run-tests.ts core",
    "test:paddle": "node tools/run-tests.ts paddle",
    "test:modular": "node tools/run-tests.ts modular",
    "test:modular:adoption": "node --test tools/test/get-modular-adoption.test.ts",
    "test:postgres": "node tools/run-tests.ts postgres",
    "test:e2e": "node tools/run-tests.ts e2e",
    "test:packed": "node tools/packed-consumers.ts",
    "test:packed:npm": "node tools/packed-consumers.ts npm",
    "test:drizzle:admission": "node tools/qualify-drizzle.ts",
    "release:dry-run": "node tools/release-dry-run.ts",
    "check:fast": "pnpm toolchain:check && pnpm typecheck && pnpm architecture:features:check && pnpm quality:coverage:scope && pnpm foundation:check",
    "check": "pnpm check:fast && pnpm lint && pnpm test:runtime-security && pnpm foundation:assert-dev-only && pnpm foundation:assert-registry && pnpm test:boundaries && pnpm test:drizzle:admission && pnpm test:core && pnpm test:paddle && pnpm test:modular && pnpm test:postgres && pnpm test:e2e && pnpm test:observation && pnpm test:packed && pnpm test:packed:npm && pnpm release:dry-run",
    "test:observation": "node tools/qualify-observation.ts",
    "architecture:features:check": "node tools/check-feature-modules.ts && pnpm test:modular:adoption",
    "architecture:features:plan": "node tools/plan-feature.ts",
    "quality:coverage:scope": "agent-teams-foundation quality check --consumer . --scope-only",
    "lint:production": "agent-teams-foundation quality check --consumer .",
    "lint:development": "oxlint --config .oxlintrc.development.json packages/*/test tools tests examples qualification",
    "typecheck:checks": "tsc -p tsconfig.checks.json"
  },
  "devDependencies": {
    "@agent-teams/engineering-foundation": "2.1.1",
    "@agent-teams/payments-core": "workspace:*",
    "@agent-teams/payments-paddle": "workspace:*",
    "@agent-teams/payments-postgres": "workspace:*",
    "@agent-teams/payments-get-modular": "workspace:*",
    "@get-modular/core": "catalog:",
    "@get-modular/assembly": "catalog:",
    "@get-modular/resources": "catalog:",
    "@get-modular/observation": "catalog:",
    "@get-modular/conformance": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "pg": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "node-or-bun": "catalog:",
    "typescript": "catalog:",
    "undici": "catalog:",
    "yaml": "catalog:",
    "@agent-teams/feature-module-standard": "0.2.3"
  },
  "repositoryAdmission": 1
}
