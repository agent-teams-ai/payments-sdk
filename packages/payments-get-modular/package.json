{
  "name": "@agent-teams/payments-get-modular",
  "version": "0.2.0",
  "type": "module",
  "description": "Optional Get Modular composition and explicit resource ownership for payments",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.21.0 <25 || >=26.11.1 <27"
  },
