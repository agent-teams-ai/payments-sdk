{
  "name": "@agent-teams/payments-postgres",
  "version": "0.3.0",
  "description": "Durable PostgreSQL payment custody, worker contracts and optional pg-boss transport for the Agent Teams payments SDK",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1 <27"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pg-boss": {
      "types": "./dist/job-transport.d.ts",
      "import": "./dist/job-transport.js"
    },
    "./node-postgres": {
      "types": "./dist/node-postgres.d.ts",
      "import": "./dist/node-postgres.js"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@agent-teams/payments-core": "workspace:^",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "mysql2": "catalog:",
    "pg-boss": "catalog:",
    "pg": "catalog:",
    "@types/pg": "catalog:"
  },
  "peerDependencies": {
    "pg-boss": "catalog:",
    "pg": "catalog:",
    "@types/pg": "catalog:"
  },
  "peerDependenciesMeta": {
    "pg-boss": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "@types/pg": {
      "optional": true
    }
  }
}
